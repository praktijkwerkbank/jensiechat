# Jensiechat: korte links in Instagram-berichten. r/gids/abc1234 telt de klik en stuurt door. Zie lib.php.
RewriteEngine On
RewriteRule ^([a-z0-9-]+)(?:/([a-z0-9]+))?(?:/(2))?/?$ index.php?s=$1&c=$2&w=$3 [L,QSA]
<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow"
Header always set Cache-Control "no-store"
</IfModule>

# Jensiechat. Besloten dashboard: nooit in zoekmachines, geen cache, motor en instellingen niet opvraagbaar.
RewriteEngine On
RewriteRule ^(lib|config|config\.voorbeeld)\.php$ - [F,L]
RewriteRule ^data(/|$) - [F,L]
RewriteRule \.(db|db-wal|db-shm|lock|sqlite|md)$ - [F,L]
Options -Indexes
DirectoryIndex index.php
<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow, noarchive"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "same-origin"
Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://*.cdninstagram.com https://*.fbcdn.net; style-src 'self'; script-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
<FilesMatch "^(index\.php|api\.php)$">
Header set Cache-Control "no-store"
</FilesMatch>
</IfModule>
